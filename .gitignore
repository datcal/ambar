# §17: no real hostnames, paths or usernames in the repository. .env.example
# uses placeholders only; the real .env stays local.
.env
.env.local

# Build output.
/dist/

# Local data. The database, derivatives and backups all live under a data root
# that must never be committed.
/data/
/testdata/library/*
/testdata/data/*
!/testdata/library/.gitkeep
!/testdata/data/.gitkeep

# SQLite, including the WAL sidecar files.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Backups.
/backups/
ambar-*.db

# Editor and OS noise. __MACOSX and .DS_Store are also §5.1 library junk, but
# here they are just the usual clutter.
.DS_Store
Thumbs.db
desktop.ini
__MACOSX/
._*
*.swp
*~
.idea/
.vscode/

# Go.
*.test
*.out
coverage.*

# The Godot plugin's test project (godot-test/). The harnesses and the project file are
# committed; everything the editor or a run generates is not — including the server URL
# and anything imported into it, which are local facts.
/godot-test/.godot/
/godot-test/assets/
/godot-test/.ambar/
/godot-test/ambar.cfg
/godot-test/CREDITS.md
/godot-test/*.png
/godot-test/*.png.import
