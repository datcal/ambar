# Ambar configuration — every variable from spec §13.
#
# Copy to .env and adjust. Placeholders only in this file: §17 requires no real
# hostnames, paths or usernames in the repository.
#
# The values shown are the defaults. Delete a line to accept its default;
# only AMBAR_BACKUP_INTERVAL and AMBAR_TRASH_RETENTION treat an explicitly
# empty value as meaningful ("disabled").

# --- Paths -------------------------------------------------------------------
# Inside the container. The host paths are set in docker-compose.yml.
#
# The container needs WRITE access to the library, not only read: .ambar.json
# sidecars are written beside originals and _inbox ingest extracts into the tree.
# Originals themselves are never modified (§3, invariant 1).
AMBAR_LIBRARY_ROOT=/library
AMBAR_DATA_ROOT=/data

# Escape hatch for a genuinely read-only library. Sidecars are then written to
# $AMBAR_DATA_ROOT/sidecars/ instead and ingest is disabled, which loses the main
# benefit of sidecars — metadata travelling with the folder. Default to false.
AMBAR_LIBRARY_READONLY=false

# --- HTTP --------------------------------------------------------------------
# The app knows nothing about how it is reached (§0). It binds plain HTTP;
# remote access is Tailscale's or Cloudflare's problem. Keep 8080 here and remap
# on the host side — DSM occupies 5000/5001 and several packages take 8080.
AMBAR_BIND=0.0.0.0:8080

# Used for links in generated output, and it decides the session cookie's Secure
# attribute when AMBAR_COOKIE_SECURE=auto.
AMBAR_BASE_URL=http://nas.example:8973

# --- Client IP trust (§2, §11) -----------------------------------------------
# Empty (the default) means forwarded-IP headers are IGNORED entirely and the
# socket peer address is used. Only fill this in if a reverse proxy genuinely
# sits in front, because this address is the key for login rate limiting — a
# spoofable value here disables that defence.
#
# Comma-separated CIDRs; a bare IP is accepted and treated as /32 or /128.
AMBAR_TRUSTED_PROXIES=

# Which header to read when the peer is a trusted proxy. Empty consults
# CF-Connecting-IP then X-Forwarded-For.
AMBAR_REAL_IP_HEADER=

# --- Cookies -----------------------------------------------------------------
# auto | true | false.
#
# §11 mandates a Secure session cookie, but §8 documents plain-HTTP LAN access
# as a real path and a Secure cookie is never sent over plain HTTP — so an
# unconditional flag would make LAN login impossible. "auto" derives it from
# AMBAR_BASE_URL's scheme. Set to true once access is HTTPS-only, which it is
# over Tailscale or Cloudflare.
AMBAR_COOKIE_SECURE=auto

# --- Secrets -----------------------------------------------------------------
# Leave empty and one is generated on first run and persisted to
# $AMBAR_DATA_ROOT/session_secret at mode 0600 (§17). Signs CSRF tokens.
# Changing it invalidates every issued CSRF token.
AMBAR_SESSION_SECRET=

# --- Library interpretation (§5.1, §17) --------------------------------------
# Junk that is never indexed, comma-separated globs, matched case-insensitively
# against any path component at any depth.
#
# __MACOSX is the one that matters: it duplicates the entire tree of a pack, so
# removing it from this list roughly DOUBLES the apparent asset count.
AMBAR_IGNORE_GLOBS=__MACOSX,.DS_Store,Thumbs.db,desktop.ini,._*,.git

# Top-level directories that organise packs rather than being packs themselves.
# A pack is then detected one level inside them.
#
# This is the only place the human-facing bucket layout is recognised, and it is
# configuration rather than policy: rename the buckets and change this line, or
# abandon them entirely (set it empty) and packs are detected at the top level.
# A .ambar.json sidecar always wins over this heuristic.
AMBAR_LIBRARY_BUCKETS=2d,3d,mix,raw,audio

# --- Workers -----------------------------------------------------------------
# How many background jobs run at once: scans, thumbnails, previews.
#
# Default low on purpose (§12): this is a NAS with a weak CPU running other
# services, and derivative generation must not starve them or freeze the UI.
AMBAR_WORKERS=2

# --- Image decoding ----------------------------------------------------------
# Refuse to decode an image larger than this many pixels.
#
# Decoding allocates roughly width x height x 4 bytes, so a 30000x30000 PNG is an
# out-of-memory on a NAS. This is the image equivalent of the archive caps below;
# §13's variable list predates the need for it. 50 megapixels is comfortably above
# any real 8K texture. Over the limit is recorded as derive_state=unsupported, which
# the UI shows plainly.
AMBAR_MAX_IMAGE_PIXELS=50000000

# --- Ingest (M4) -------------------------------------------------------------
# 100 MB. Note that Cloudflare's free plan caps request bodies at 100 MB
# regardless; large archives go through _inbox over SMB instead.
AMBAR_MAX_UPLOAD_SIZE=104857600

# 20 GB total uncompressed, as a zip-bomb defence alongside an entry-count cap.
AMBAR_MAX_ARCHIVE_UNCOMPRESSED=21474836480

# Polling, not inotify, because it must work across SMB and Docker bind mounts.
AMBAR_INBOX_POLL_INTERVAL=30s

# --- Backups (M11) -----------------------------------------------------------
# In-process VACUUM INTO on a ticker. Empty disables the internal scheduler.
# Take backups at the SQLite level, never via a btrfs/ZFS snapshot of a live WAL
# database.
AMBAR_BACKUP_INTERVAL=1h
AMBAR_BACKUP_DIR=/data/backups
AMBAR_BACKUP_KEEP=48

# --- Trash and dedupe (M13) --------------------------------------------------
# Nothing is ever deleted in place; removals move here with their original
# relative path preserved (§9.1).
AMBAR_TRASH_DIR=/library/_trash

# Empty (the default) means NEVER auto-purge — manual only. Nothing in this
# application deletes on a schedule, including under disk pressure.
AMBAR_TRASH_RETENTION=

# reflink | hardlink | off. Selects how a user-initiated dedupe acts, not
# whether one happens. reflink (btrfs copy-on-write) is preferred where
# supported; DSM 7 volumes are commonly btrfs.
AMBAR_DEDUPE_LINK_MODE=reflink

# --- Reaching the library from your own machine (M14) ------------------------
# How the library is mounted where *you* work, not where Ambar runs. A browser
# cannot launch Aseprite or Blender for you, and this server usually runs on the
# NAS — so Ambar shows the local path instead, one click to copy.
#
# An SMB URL (macOS/Linux):   smb://nas.local/game/assets
# A UNC path (Windows):       \\nas\game\assets
# A local mount point:        /Volumes/game/assets  or  Z:\game\assets
#
# Empty hides the feature rather than offering a path that would not work.
AMBAR_LOCAL_LIBRARY_PATH=

# --- Optional external tools -------------------------------------------------
# Both are optional and never baked into the image (§6). Bind-mount and point
# here if wanted. Aseprite's licence does not permit redistribution; the pure-Go
# .aseprite parser is the primary path and this is only a fallback for format
# versions it does not handle.
AMBAR_ASEPRITE_BIN=
AMBAR_BLENDER_BIN=

# --- Logging -----------------------------------------------------------------
# Not in §13, but useful in a container. debug | info | warn | error, and
# text | json.
AMBAR_LOG_LEVEL=info
AMBAR_LOG_FORMAT=text
